# Copy to .env and fill in only what you need. Nothing here is required:
# the tool runs keyless (Tavily access mode, Jina Reader, Google News RSS,
# Internet Archive, Tesseract). See docs/api-keys.md.

# --- discovery ---------------------------------------------------------------
BRAVE_API_KEY=
TAVILY_API_KEY=
PARALLEL_API_KEY=
TINYFISH_API_KEY=

# --- OCR ---------------------------------------------------------------------
GEMINI_API_KEY=
VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=
MISTRAL_API_KEY=

# --- paths (optional) --------------------------------------------------------
WEBTRAWL_CONFIG=
WEBTRAWL_CACHE_DIR=
WEBTRAWL_IMAGE_CACHE_DIR=
WEBTRAWL_BROWSER_PROFILE=
WEBTRAWL_OCR_CONFIG=
WEBTRAWL_OCR_CACHE=
